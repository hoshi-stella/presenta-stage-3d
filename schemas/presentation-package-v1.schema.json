{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presenta-stage-3d.dev/schemas/presentation-package-v1.schema.json",
  "title": "Presentation Package v1",
  "type": "object",
  "required": ["schemaVersion", "presentation", "slides", "cues", "characters", "assets", "directionPresets", "settings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "presentation": {
      "type": "object",
      "required": ["id", "title", "author", "language"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } },
        "language": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "slides": { "type": "array" },
    "cues": { "type": "array", "minItems": 1 },
    "characters": { "type": "array" },
    "assets": { "type": "array" },
    "directionPresets": { "type": "array" },
    "settings": { "type": "object" }
  },
  "additionalProperties": true
}
