  "slides": [
    {
      "id": "slide_title",
      "layout": "title",
      "title": "データ構造とアルゴリズムを、操作から選ぶ",
      "subtitle": "Stack / Queue / Buffer / Sort / 計算量",
      "body": "速さのためだけではなく、必要な操作を安全に表現するための選択です。"
    },
    {
      "id": "slide_problem",
      "layout": "content",
      "title": "まず考えるのは、何をしたいか",
      "bullets": [
        "末尾に追加したい",
        "先頭から順に取り出したい",
        "最後に追加したものを戻したい",
        "常に小さい順で扱いたい"
      ],
      "footer": "データ構造は、よく行う操作を得意にするための形です。"
    },
    {
      "id": "slide_complexity",
      "layout": "grid",
      "title": "計算量は、入力が増えたときの伸び方を見る",
      "columns": [
        {
          "title": "O(1)",
          "body": "要素数に関係なく、ほぼ一定"
        },
        {
          "title": "O(log n)",
          "body": "半分ずつ絞り込む"
        },
        {
          "title": "O(n)",
          "body": "一度全体を見る"
        },
        {
          "title": "O(n log n)",
          "body": "実用的な比較ソートの代表"
        },
        {
          "title": "O(n^2)",
          "body": "全組み合わせを比べると増えやすい"
        }
      ],
      "footer": "計算量は目安です。実際にはデータ量、メモリ、実装、キャッシュも効きます。"
    },
    {
      "id": "slide_animation_map",
